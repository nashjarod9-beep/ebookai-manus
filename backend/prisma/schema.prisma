generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  plan         String   @default("free")
  books        Book[]
  createdAt    DateTime @default(now())
}

model Book {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String
  subject      String
  description  String?
  language     String    @default("fr")
  coverUrl     String?
  format       String    @default("static")  // "static" | "interactive"
  status       String    @default("draft")   // "draft" | "generating" | "ready"
  outline      String?   // JSON stringified
  pdfPath      String?
  zipPath      String?
  chapters     Chapter[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title       String
  content     String   // Markdown
  imageUrl    String?
  imagePrompt String?
  order       Int
  quizzes     String?  // JSON stringified: [{question, options[], correctIndex}]
  videoUrl    String?
  audioPath   String?
  createdAt   DateTime @default(now())
}
