generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  plan              String    @default("free") // "free" | "starter" | "creator" | "business" | "agency"
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  ebooksConsumed    Int       @default(0)
  quotaRemaining    Int       @default(0)
  books             Book[]
  storageAssets     StorageAsset[]
  aiUsageLogs       AiUsageLog[]
  subscription      Subscription?
  creditTransactions CreditTransaction[]
  auditLogs         AuditLog[]
  createdAt         DateTime  @default(now())
}

model Book {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  title        String
  subject      String
  description  String?
  language     String    @default("fr")
  coverUrl     String?
  format       String    @default("static")  // "static" | "interactive"
  status       String    @default("draft")   // "draft" | "generating" | "ready"
  outline      String?   // JSON stringified
  pdfPath      String?
  zipPath      String?
  modelUsed    String?     // Model used for outline (deepseek-chat or qwen-plus)
  author       String?
  contactInfo  String?
  targetPages  String?
  additionalInstructions String? // User specific design guidelines
  chapters     Chapter[]
  marketingAsset MarketingAsset?
  generationJobs GenerationJob[]
  aiUsageLogs    AiUsageLog[]
  creditTransactions CreditTransaction[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title       String
  content     String   // Markdown
  imageUrl    String?
  imagePrompt String?
  order       Int
  quizzes     String?  // JSON stringified: [{question, options[], correctIndex}]
  videoUrl    String?
  audioPath   String?
  modelUsed   String?  // Model used for this chapter
  createdAt   DateTime @default(now())
}

model MarketingAsset {
  id            String   @id @default(cuid())
  bookId        String   @unique
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  productSheet  String?  @db.Text
  tiktokScripts String?  @db.Text // JSON stringified array of scripts
  whatsappMsgs  String?  @db.Text // JSON stringified array of messages
  mockupUrl1    String?  // Variante 1: Livre posé sur une table
  mockupUrl2    String?  // Variante 2: Livre tenu dans une main
  mockupUrl3    String?  // Variante 3: Livre avec ordinateur portable
  createdAt     DateTime @default(now())
}

model GenerationJob {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status      String   // "queued" | "running" | "completed" | "failed"
  currentStep String?
  totalSteps  Int
  stepIndex   Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StorageAsset {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  version      String   @default("1.0.0")
  taille       Int
  hash         String
  utilisateurId String
  user         User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  format       String
  origine      String
  workerId     String?
  statut       String   @default("active")
  path         String   @unique
  url          String
  createdAt    DateTime @default(now())
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId           String?
  book             Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  provider         String
  model            String
  tokensOrCredits  Int      @default(0)
  costEstimateFcfa Float    @default(0.0)
  durationMs       Int      @default(0)
  success          Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   // "free" | "starter" | "creator" | "business" | "agency"
  creditsAllocated  Int
  creditsRemaining  Int
  cycleStartDate    DateTime
  cycleEndDate      DateTime
  status            String   // "active" | "canceled" | "past_due"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // ex. "chapter_write", "illustration", "cover", ...
  amount      Int      // négatif = consommation, positif = crédit (achat, remboursement)
  bookId      String?
  book        Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "login" | "password_change" | "purchase" | "export" | "delete" | "share"
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}
